# krs.ldap.LDAP()'s read methods (list_users, get_user, list_groups, get_group)
# bind anonymously by design; grant read access to match. userPassword stays
# protected by the more specific rule above (first-match-wins).
dn: olcDatabase={1}mdb,cn=config
changetype: modify
delete: olcAccess
-
add: olcAccess
olcAccess: to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * break
olcAccess: to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=icecube,dc=wisc,dc=edu" write by anonymous auth by * none
olcAccess: to * by self read by dn="cn=admin,dc=icecube,dc=wisc,dc=edu" write by * read
